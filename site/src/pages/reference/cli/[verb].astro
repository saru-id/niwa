---
import * as stylex from '@stylexjs/stylex'
import Layout from '../../../components/Layout.astro'
import NextLinks from '../../../components/NextLinks.astro'
import { ReferenceTable } from '../../../components/DataTable'
import { Screen } from '../../../components/Screen'
import { pageLink } from '../../../data/links'
import { GLOBAL_FLAGS, VERBS, neighbour, usage } from '../../../data/verbs'
import { EXHIBIT } from '../../../styles/frames.stylex'
import { TYPE } from '../../../styles/type.stylex'
import { styles } from '../_styles'

// Twenty pages from one template. The props carry the verb itself, so the
// page never looks a name back up.
export function getStaticPaths() {
  return VERBS.map((verb) => ({ params: { verb: verb.name }, props: { verb } }))
}

const { verb } = Astro.props
const command = verb.name === 'niwa' ? 'niwa' : `niwa ${verb.name}`
// Bare `niwa` is the tool's own front door, so the global flags are
// tabled there and every other page points at that table.
const dashboard = verb.name === 'niwa'

const sections = [
  verb.arguments.length > 0 && { id: 'arguments', text: 'Arguments' },
  verb.flags.length > 0 && { id: 'flags', text: 'Flags' },
  dashboard && { id: 'global-flags', text: 'Global flags' },
  verb.exits.length > 0 && { id: 'exit-codes', text: 'Exit codes' },
  verb.screens.length > 0 && { id: 'screens', text: 'Screens' },
].filter((section) => section !== false && section !== undefined)

const headings = sections.map((section) => ({
  depth: 2 as const,
  id: section.id,
  text: section.text,
}))

const after = neighbour(verb)
const next = [
  pageLink(verb.concept),
  {
    href: after.path,
    label: after.name === 'niwa' ? 'niwa' : `niwa ${after.name}`,
    why: 'the next verb in this group',
  },
]
---

<Layout title={command} description={verb.job} headings={headings}>
  <h1 {...stylex.props(TYPE.title)}>{command}</h1>
  <p {...stylex.props(TYPE.deck)}>{verb.job}</p>
  <pre
    {...stylex.props(EXHIBIT.block, EXHIBIT.frame, EXHIBIT.air, styles.signature)}
    tabindex="0"><code>{usage(verb)}</code></pre>

  {
    verb.arguments.length > 0 && (
      <Fragment>
        <h2 id="arguments" {...stylex.props(TYPE.chapter, TYPE.section)}>
          Arguments
        </h2>
        <ReferenceTable
          columns={[{ header: 'Argument', identifier: true }, { header: 'Meaning' }]}
          rows={verb.arguments.map((argument) => [argument.name, argument.meaning])}
        />
      </Fragment>
    )
  }

  {
    verb.flags.length > 0 && (
      <Fragment>
        <h2 id="flags" {...stylex.props(TYPE.chapter, TYPE.section)}>
          Flags
        </h2>
        <ReferenceTable
          columns={[
            { header: 'Flag', identifier: true },
            { header: 'Argument', identifier: true },
            { header: 'Meaning' },
          ]}
          rows={verb.flags.map((flag) => [
            flag.name,
            flag.argument === '' ? '—' : flag.argument,
            flag.meaning,
          ])}
        />
      </Fragment>
    )
  }

  {
    dashboard ? (
      <Fragment>
        <h2 id="global-flags" {...stylex.props(TYPE.chapter, TYPE.section)}>
          Global flags
        </h2>
        <p {...stylex.props(TYPE.paragraph)}>Every verb takes these two.</p>
        <ReferenceTable
          columns={[{ header: 'Flag', identifier: true }, { header: 'Meaning' }]}
          rows={GLOBAL_FLAGS.map((flag) => [flag.name, flag.meaning])}
        />
      </Fragment>
    ) : (
      <p {...stylex.props(TYPE.paragraph)}>
        <code>-v</code>, <code>--verbose</code> and <code>--debug</code> are global and this
        verb takes them too.{' '}
        <a href="/reference/cli/niwa#global-flags">The global flags table</a> lists them.
      </p>
    )
  }

  {
    verb.exits.length > 0 && (
      <Fragment>
        <h2 id="exit-codes" {...stylex.props(TYPE.chapter, TYPE.section)}>
          Exit codes
        </h2>
        <ReferenceTable
          columns={[{ header: 'Code', identifier: true }, { header: 'When' }]}
          rows={verb.exits.map((exit) => [String(exit.code), exit.when])}
        />
      </Fragment>
    )
  }

  {
    verb.screens.length > 0 && (
      <Fragment>
        <h2 id="screens" {...stylex.props(TYPE.chapter, TYPE.section)}>
          Screens
        </h2>
        <p {...stylex.props(TYPE.paragraph)}>
          {verb.screens.length === 1
            ? 'The screen below is a snapshot the tool wrote, reproduced byte for byte.'
            : 'The screens below are snapshots the tool wrote, reproduced byte for byte.'}
        </p>
        {verb.screens.map((screen) => (
          <Screen fixture={screen.fixture} command={screen.command} />
        ))}
      </Fragment>
    )
  }

  <NextLinks links={next} />
</Layout>
