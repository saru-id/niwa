---
import * as stylex from '@stylexjs/stylex'
import Layout from '../../components/Layout.astro'
import NextLinks from '../../components/NextLinks.astro'
import { envOf } from '../../data/env'
import { pageLink } from '../../data/links'
import { styles } from './_styles'

const deck =
  'Everything in the environment that changes what niwa does. Nothing else in it is read.'

const tables = [
  {
    id: 'the-tool',
    title: 'What niwa reads',
    lead: 'A path variable is honored only when it is absolute. Anything else is ignored, and the default stands.',
    rows: envOf('tool'),
  },
  {
    id: 'the-installer',
    title: 'What the installer reads',
    lead: 'install.sh reads two more. They are for mirrors and for testing; neither is needed to install niwa.',
    rows: envOf('installer'),
  },
]

const headings = tables.map((table) => ({
  depth: 2 as const,
  id: table.id,
  text: table.title,
}))

const next = [pageLink('/reference/files'), pageLink('/reference')]
---

<Layout title="Environment variables" description={deck} headings={headings}>
  <h1 {...stylex.props(styles.h1)}>Environment variables</h1>
  <p {...stylex.props(styles.deck)}>{deck}</p>

  {
    tables.map((table) => (
      <Fragment>
        <h2 id={table.id} {...stylex.props(styles.h2)}>
          {table.title}
        </h2>
        <p {...stylex.props(styles.p)}>{table.lead}</p>
        <div {...stylex.props(styles.tableFrame)} tabindex="0">
          <table {...stylex.props(styles.table)}>
            <thead data-pagefind-ignore>
              <tr>
                <th {...stylex.props(styles.th)}>Variable</th>
                <th {...stylex.props(styles.th)}>What it does</th>
              </tr>
            </thead>
            <tbody>
              {table.rows.map((variable, index) => (
                <tr>
                  <td
                    {...stylex.props(
                      styles.td,
                      styles.cell,
                      index === table.rows.length - 1 && styles.lastRow,
                    )}
                  >
                    {variable.name}
                  </td>
                  <td
                    {...stylex.props(styles.td, index === table.rows.length - 1 && styles.lastRow)}
                  >
                    {variable.role}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Fragment>
    ))
  }

  <NextLinks links={next} />
</Layout>
