---
import * as stylex from '@stylexjs/stylex'
import Layout from '../../components/Layout.astro'
import NextLinks from '../../components/NextLinks.astro'
import { ReferenceTable } from '../../components/DataTable'
import { envOf } from '../../data/env'
import { pageLink } from '../../data/links'
import { TYPE } from '../../styles/type.stylex'

const deck =
  'Everything in the environment that changes what niwa does. Nothing else in it is read.'

const tables = [
  {
    id: 'the-tool',
    title: 'What niwa reads',
    lead: 'A path variable is honored only when it is absolute. Anything else is ignored, and the default stands.',
    rows: envOf('tool'),
  },
  {
    id: 'the-installer',
    title: 'What the installer reads',
    lead: 'install.sh reads two more. They are for mirrors and for testing; neither is needed to install niwa.',
    rows: envOf('installer'),
  },
]

const headings = tables.map((table) => ({
  depth: 2 as const,
  id: table.id,
  text: table.title,
}))

const next = [pageLink('/reference/files'), pageLink('/reference')]
---

<Layout title="Environment variables" description={deck} headings={headings}>
  <h1 {...stylex.props(TYPE.title)}>Environment variables</h1>
  <p {...stylex.props(TYPE.deck)}>{deck}</p>

  {
    tables.map((table) => (
      <Fragment>
        <h2 id={table.id} {...stylex.props(TYPE.chapter, TYPE.section)}>
          {table.title}
        </h2>
        <p {...stylex.props(TYPE.paragraph)}>{table.lead}</p>
        <ReferenceTable
          columns={[{ header: 'Variable', identifier: true }, { header: 'What it does' }]}
          rows={table.rows.map((variable) => [variable.name, variable.role])}
        />
      </Fragment>
    ))
  }

  <NextLinks links={next} />
</Layout>
