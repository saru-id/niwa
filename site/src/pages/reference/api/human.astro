---
import { pageLink } from '../../../data/links'
import { groupOf, resourcesOf } from '../../../data/resources'
import ApiPage from '../_ApiPage.astro'

const group = groupOf('human')
const entries = resourcesOf('human').map((resource) => ({
  name: resource.name,
  signatures: [resource.signature],
  description: resource.description,
}))
const next = [pageLink('/concepts/checklist'), pageLink('/reference/api/functions')]
---

<ApiPage title={group.title} deck={group.deck} entries={entries} next={next} />
