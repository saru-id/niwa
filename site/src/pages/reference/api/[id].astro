---
/* The Luau API reference: seven pages, one route.
 *
 * Every page is a run of entries. An entry is a heading, a signature, and
 * a paragraph. Five of the seven pages hold the resource calls, grouped by
 * what a person is doing. The other two hold the calls that are not
 * resources, and the facts a config can read.
 */
import * as stylex from '@stylexjs/stylex'
import Layout from '../../../components/Layout.astro'
import NextLinks from '../../../components/NextLinks.astro'
import { FACTS } from '../../../data/facts'
import { FUNCTIONS } from '../../../data/functions'
import type { PageLink } from '../../../data/links'
import { pageLink } from '../../../data/links'
import type { GroupId } from '../../../data/resources'
import { anchor, groupOf, resourcesOf } from '../../../data/resources'
import { EXHIBIT } from '../../../styles/frames.stylex'
import { TYPE } from '../../../styles/type.stylex'
import { styles } from '../_styles'

/** One name on a page. */
interface Entry {
  readonly name: string
  /** One line, or several where the call is overloaded. */
  readonly signatures: readonly string[]
  readonly description: string
}

/** One page: the last segment of its URL, its furniture, and its names. */
interface ApiPage {
  readonly id: string
  readonly title: string
  readonly deck: string
  readonly entries: readonly Entry[]
  readonly next: readonly PageLink[]
}

// Astro runs this function in a scope of its own, and file imports are all
// it reaches. The seven pages are declared inside it for that reason.
export function getStaticPaths() {
  /*
   * The entries of one resource group.
   *
   * The group declares the page it renders on. This route serves that page.
   * The two are one address said twice, so a rename that moves one and not
   * the other stops the build.
   */
  const callsOf = (id: GroupId): readonly Entry[] => {
    const group = groupOf(id)
    if (group.path !== `/reference/api/${id}`) {
      throw new Error(
        `The ${id} group declares ${group.path} as its page, and this route ` +
          `serves /reference/api/${id}. The two are one address said twice. ` +
          'Fix GROUPS in src/data/resources.ts. The site did not build.',
      )
    }
    return resourcesOf(id).map((resource) => ({
      name: resource.name,
      signatures: [resource.signature],
      description: resource.description,
    }))
  }

  const pages: readonly ApiPage[] = [
    {
      id: 'packages',
      title: 'Packages and tools',
      deck: 'Seven calls install software: Homebrew, the App Store, npm, mise, and GitHub releases.',
      entries: callsOf('packages'),
      next: [pageLink('/guides/packages'), pageLink('/reference/api/files')],
    },
    {
      id: 'files',
      title: 'Files and links',
      deck: 'Two calls put files where they belong. One copies, one links, and the difference matters.',
      entries: callsOf('files'),
      next: [pageLink('/guides/dotfiles'), pageLink('/reference/api/settings')],
    },
    {
      id: 'settings',
      title: 'System settings',
      deck: 'Six calls declare what macOS itself does: preference domains, the Dock, the Finder, and three machine-wide settings.',
      entries: callsOf('settings'),
      next: [pageLink('/guides/system-settings'), pageLink('/reference/api/services')],
    },
    {
      id: 'services',
      title: 'Services',
      deck: 'Three calls run things: a launchd agent, a guarded command, and a body that runs once.',
      entries: callsOf('services'),
      next: [pageLink('/guides/services'), pageLink('/reference/api/human')],
    },
    {
      id: 'human',
      title: 'Manual steps',
      deck: 'Two calls describe work only a person can do. Both are checklist items, never prompts.',
      entries: callsOf('human'),
      next: [pageLink('/concepts/checklist'), pageLink('/reference/api/functions')],
    },
    {
      id: 'functions',
      title: 'Luau utilities',
      deck: 'Eight calls that are not resources. They return values, load code, or define a kind of your own, and none of them produces a plan line.',
      entries: FUNCTIONS,
      next: [pageLink('/guides/custom-resource'), pageLink('/reference/api/facts')],
    },
    {
      id: 'facts',
      title: 'Facts',
      deck: 'Seven values a config can read about the machine it runs on. They are gathered once per run, so twenty guards asking the same question cost one answer.',
      entries: FACTS.map((fact) => ({
        name: fact.name,
        signatures: [fact.signature],
        description: fact.description,
      })),
      next: [pageLink('/reference/api/functions'), pageLink('/concepts/config')],
    },
  ]

  return pages.map((page) => ({ params: { id: page.id }, props: { page } }))
}

const { page } = Astro.props
const { title, deck, entries, next } = page
const headings = entries.map((entry) => ({
  depth: 2 as const,
  id: anchor(entry.name),
  text: entry.name,
}))
---

<Layout title={title} description={deck} headings={headings}>
  <h1 {...stylex.props(TYPE.title, styles.h1)}>{title}</h1>
  <p {...stylex.props(TYPE.deck, styles.deck)}>{deck}</p>
  {
    entries.map((entry) => (
      <Fragment>
        <h2 id={anchor(entry.name)} {...stylex.props(styles.h2)}>
          {entry.name}
        </h2>
        {/* On one line: a `pre` keeps every byte between its tags. */}
        {entry.signatures.map((signature) => (
          <pre {...stylex.props(EXHIBIT.frame, styles.signature)} tabindex="0"><code>{signature}</code></pre>
        ))}
        <p {...stylex.props(styles.p)}>{entry.description}</p>
      </Fragment>
    ))
  }
  <NextLinks links={next} />
</Layout>
