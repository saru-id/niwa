---
import * as stylex from '@stylexjs/stylex'
import { styles as shell } from '../components/Layout.styles'
import Layout from '../components/Layout.astro'
import { Markdown } from '../components/Markdown'
import { Screen } from '../components/Screen'
import { styles } from '../components/Landing.styles'

/* The landing.
 *
 * Five bands inside the shell: the statement, the config, the screen, the
 * daily loop, the boundary. The header and the footer are the shell's.
 * Bands 2 and 3 are one exhibit: the tool's own test writes that config
 * verbatim and snapshots the plan it produces.
 */

// The source a refused fence names. This page holds its own markdown.
const SELF = 'src/pages/index.astro'

// Both blocks go through the same markdown pipeline the documentation uses,
// so the frame, the language badge and the copy control are the site's own.
const INSTALL = ['```shell', 'curl -fsSL niwa.rs | sh', '```'].join('\n')

const CONFIG_SOURCE = `--!strict
local niwa = require("@niwa")

niwa.brew.formula { "fd", "ripgrep", "jq" }

niwa.dock {
  autohide = true,
  tilesize = 48,
}

niwa.file("~/.zshrc", { source = "@self/files/zshrc" })

local nvim = niwa.brew.formula "neovim"
local cfg  = niwa.link("~/.config/nvim", { to = "@self/files/nvim" })
if nvim.changed or cfg.changed then
  niwa.run("nvim --headless '+Lazy! sync' +qa", { timeout = "5m" })
end`

const CONFIG = ['```luau', CONFIG_SOURCE, '```'].join('\n')

/* Band 3 is the plan the config above produces: the tool's own test writes
 * that config verbatim and snapshots this screen. */
const PLAN = 'plan_mixed_pending_color'
---

{/* The landing renders no rail: it draws its own full-width bands, and its
  header carries the navigation at every width. */}
<Layout description="niwa is a configuration tool for macOS." carriesNavigation>
  {/* Band 1. The statement, one hairline, and what follows from it. */}
  <section {...stylex.props(shell.column, styles.bandStatement)}>
    <div {...stylex.props(styles.column)}>
      <h1 {...stylex.props(styles.statement)}>
        Your whole Mac, configured by one script you can actually read.
      </h1>
      <hr {...stylex.props(styles.rule)} />
      <p {...stylex.props(styles.lede)}>
        niwa is a configuration tool for macOS. One Luau script declares what the machine
        should be: packages, dotfiles, settings, and services. Applying it makes that true.
        Apply again and almost nothing happens, because almost everything is already true.
      </p>
      <div {...stylex.props(styles.install)}>
        <Markdown source={INSTALL} file={SELF} />
      </div>
      <p {...stylex.props(styles.secondary)}>
        <a href="/start">What the installer touches</a>
      </p>
    </div>
  </section>

  {/* Band 2. The config. */}
  <section {...stylex.props(shell.column, styles.band)}>
    <div {...stylex.props(styles.column)}>
      <figure {...stylex.props(styles.figure)}>
        {/* No client directive. React runs once, during the build. */}
        <Markdown source={CONFIG} file={SELF} />
        <figcaption {...stylex.props(styles.caption)}>init.luau</figcaption>
      </figure>
    </div>
  </section>

  {/* Band 3. The screen that config produces. Read as one pair with band 2. */}
  <section {...stylex.props(shell.column, styles.band)}>
    <div {...stylex.props(styles.column)}>
      <Screen fixture={PLAN} command="niwa plan" />
    </div>
  </section>

  {/* Band 4. The three motions, numbered. */}
  <section {...stylex.props(shell.column, styles.band)}>
    <div {...stylex.props(styles.column)}>
      <h2 {...stylex.props(styles.heading)}>The daily loop</h2>
      <ol {...stylex.props(styles.steps)}>
        <li {...stylex.props(styles.step)}>
          <span {...stylex.props(styles.numeral)}>1</span>
          <div>
            <p {...stylex.props(styles.stepText)}>
              Change the machine through the config. Add a line, run{' '}
              <code {...stylex.props(styles.code)}>niwa apply</code>, done.
            </p>
            <p {...stylex.props(styles.onward)}>
        <a href="/start/first-apply">Your first apply</a>
            </p>
          </div>
        </li>
        <li {...stylex.props(styles.step)}>
          <span {...stylex.props(styles.numeral)}>2</span>
          <div>
            <p {...stylex.props(styles.stepText)}>
              Change the machine directly, then keep it. niwa notices, and offers the config
              line back. Accept it, and your script says what your machine says.
            </p>
            <p {...stylex.props(styles.onward)}>
        <a href="/concepts/drift">Drift and the write-back loop</a>
            </p>
          </div>
        </li>
        <li {...stylex.props(styles.step)}>
          <span {...stylex.props(styles.numeral)}>3</span>
          <div>
            <p {...stylex.props(styles.stepText)}>
              Set up a new machine. One command, then read the plan and confirm.
            </p>
            <p {...stylex.props(styles.onward)}>
        <a href="/start/second-machine">Set up a second machine</a>
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  {/* Band 5. The boundary. */}
  <section {...stylex.props(shell.column, styles.bandLast)}>
    <div {...stylex.props(styles.column)}>
      <h2 {...stylex.props(styles.heading)}>What niwa will not do</h2>
      <p {...stylex.props(styles.boundaryText)}>
        It never applies on its own. The watcher notices and notifies; applying is your call,
        unless you declare a schedule yourself.
      </p>
      <p {...stylex.props(styles.boundaryText)}>
        Undo restores what the last apply changed. It is not a rollback of the whole world.
      </p>
      <p {...stylex.props(styles.boundaryText)}>
        One plan, in your order. Program order is the order; there is no dependency graph to
        out-guess you.
      </p>
      <p {...stylex.props(styles.boundaryOnward)}>
        <a href="/concepts/limits">Every refusal, with its reason</a>
      </p>
    </div>
  </section>

  <script>
    import '../scripts/copy'
  </script>
</Layout>
