---
/* The landing.
 *
 * A garden over near-black, the promise in the calm left field, and the
 * install line under it. Below that the same page in words: what niwa is,
 * one real config beside the real plan it produces, the three motions of a
 * day, the limits, and three ways into the documentation.
 *
 * The page draws its own structure. The layout hands this slot straight to
 * the body, so the header, the main and the sections below are all stated
 * here rather than borrowed from the documentation's chrome.
 */
import Layout from '../components/Layout.astro'
import Boundary from '../components/landing/Boundary.astro'
import Config from '../components/landing/Config.astro'
import Converged from '../components/landing/Converged.astro'
import Drift from '../components/landing/Drift.astro'
import Hero from '../components/landing/Hero.astro'
import InstallCta from '../components/landing/InstallCta.astro'
import LandingNav from '../components/landing/Nav.astro'
import Why from '../components/landing/Why.astro'
import { heroDesktop, heroMobile } from '../lib/hero-art'
import '../styles/landing.css'

// The pair splits on width alone, and deliberately does not follow
// LANDING_QUERY: that boundary decides which composition the art is drawn
// in, and this one decides how many bytes of it to send. An upright tablet
// takes the covered composition and paints the art across a screen far
// larger than a phone's, so it is served the fuller encode. 781 is the
// width's complement, so the two preloads split the viewports with no gap
// and no overlap.
const NARROW = '(max-width: 780px)'
const WIDE = '(min-width: 781px)'
---

<Layout
  surface="landing"
  pageTitle="niwa · your Mac, cultivated"
  description="niwa grows a complete macOS setup from one readable Luau file."
>
  {
    /* The hero is the first paint, and its two encodes are split on the
      landing's own breakpoint. The preloads carry the same split, so the
      browser starts the one file it will actually draw before it has parsed
      the picture that names it. */
  }
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href={heroMobile.src}
      media={NARROW}
    />
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href={heroDesktop.src}
      media={WIDE}
    />
  </Fragment>

  <div id="top">
    <LandingNav />
    {
      /* Search indexes what the page says, which is the main and not the
        header's four words. */
    }
    <main id="main" data-pagefind-body>
      <Hero />
      {
        /* Everything below the hero rides over the pinned garden on its own
          opaque ground, which is what ends the garden's hold on the window. */
      }
      <div class="story">
        <Why />
        <Config />
        <Drift />
        <Converged />
        <Boundary />
        <InstallCta />
      </div>
    </main>
  </div>

  <script>
    import '../scripts/copy'
  </script>
  <script>
    import { start } from '../scripts/landing/ui'
    start()
  </script>
  <script>
    import { start } from '../scripts/landing/index'
    start()
  </script>
</Layout>
