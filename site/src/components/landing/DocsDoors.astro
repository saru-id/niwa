---
/* Three doors into the documentation.
 *
 * The names are the sidebar's own, read from `src/nav.ts` rather than typed
 * again here: a reader who follows a door meets the same word at the top of
 * the rail, and a group that is renamed or removed stops the build instead
 * of leaving a door that lies.
 *
 * This emits the list and not a section. The doors stand at the foot of the
 * last screen, under the command, because they are what a reader takes
 * instead of installing — and a section of their own, a screen earlier,
 * interrupted the argument on its way to the point.
 */
import { NAV } from '../../nav'

/** A card's destination and the line that says what is behind it. */
const DOORS = [
  { path: '/start', line: 'Install niwa, write the first config, run the first apply.' },
  {
    path: '/concepts',
    line: 'What a config declares, what a plan is, and where the boundaries sit.',
  },
  {
    path: '/reference',
    line: 'Commands checked against the binary on every build. Calls pinned to the shipped types.',
  },
]

function labelFor(path: string): string {
  const group = NAV.find((candidate) => candidate.entries.some((page) => page.path === path))
  if (group === undefined) {
    throw new Error(
      `Naming the landing's door for ${path}. No group in src/nav.ts carries that ` +
        'page, so the door has no name to take. Point the door at a path NAV ' +
        'carries, or add the page to NAV. The site did not build.',
    )
  }
  return group.label
}

const cards = DOORS.map((door) => ({ ...door, label: labelFor(door.path) }))
---

<nav class="doors" aria-label="Documentation">
  <p class="doors-say" id="doors-say">Not yet. Read first:</p>
  <ul class="doors-list" aria-labelledby="doors-say">
    {
      cards.map((card) => (
        <li>
          <a class="door" href={card.path}>
            <span class="door-name">{card.label}</span>
            <span class="door-line">{card.line}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
