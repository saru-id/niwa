---
/* A directory structure. Static markup, no script.
 *
 * `TreeBlock` draws the whole thing; markdown `tree` fences render the same
 * component through the pipeline.
 */
import type { PreparedTree } from '../lib/tree'
import { TreeBlock } from './TreeBlock'

interface Props {
  tree: PreparedTree
  /** The root the tree hangs from, for example `~/.config/niwa`. */
  label: string
  /** The tree's id, unique on the page. */
  id?: string
}

const { tree, label, id } = Astro.props
---

<TreeBlock tree={tree} label={label} id={id} />
