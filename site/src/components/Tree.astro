---
/* A directory structure, server rendered.
 *
 * A thin wrapper: `TreeBlock` renders the figure and the SSR payload, and
 * this file adds the loader that hydrates a tree when it approaches the
 * viewport. Markdown `tree` fences render `TreeBlock` through the pipeline
 * instead, and the docs template carries the loader for them.
 */
import type { PreparedTree } from '../lib/tree'
import { TreeBlock } from './TreeBlock'

interface Props {
  tree: PreparedTree
  /** The root the tree hangs from, for example `~/.config/niwa`. */
  label: string
  /** The tree's id, unique on the page. */
  id?: string
}

const { tree, label, id } = Astro.props
---

<TreeBlock tree={tree} label={label} id={id} />
<script src="./Tree.loader.ts"></script>
