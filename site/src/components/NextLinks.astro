---
import * as stylex from '@stylexjs/stylex'
import { TYPE } from '../styles/type.stylex'
import { styles } from './NextLinks.styles'

/** One to three, written by hand. There is no mechanical next page. */
export interface NextLink {
  href: string
  label: string
  /** The clause that says why to follow this link. */
  why: string
}

interface Props {
  links: readonly NextLink[]
}

const { links } = Astro.props
---

<div {...stylex.props(TYPE.chapter)}>
  <p {...stylex.props(styles.label)}>Next</p>
  <ul {...stylex.props(TYPE.entries)}>
    {
      links.map((link) => (
        <li {...stylex.props(TYPE.item)}>
          <a href={link.href}>{link.label}</a>{' '}
          <span {...stylex.props(TYPE.said)}>— {link.why}</span>
        </li>
      ))
    }
  </ul>
</div>
