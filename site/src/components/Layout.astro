---
import * as stylex from '@stylexjs/stylex'
import type { Heading } from '../lib/headings'
import '../styles/app.css'
import Footer from './Footer.astro'
import Header from './Header.astro'
import { styles } from './Layout.styles'
import Search from './Search.astro'
import Sidebar from './Sidebar.astro'
import Toc from './Toc.astro'

interface Props {
  /** Absent on the landing, where the site's name is the whole title. */
  title?: string
  description: string
  /** Absent when the page has no headings. The rail then does not exist. */
  headings?: readonly Heading[]
  /** Search indexes every page unless the page says otherwise. Opting out
   * is for pages that answer nobody's search, like the 404. */
  indexed?: boolean
}

const { title, description, headings, indexed = true } = Astro.props
const pathname = Astro.url.pathname
// A page with no headings has no rail, and its grid keeps two columns.
const toc = headings !== undefined && headings.length > 0 ? headings : undefined
---

<!doctype html>
<html lang="en">
  <head>
    {
      /* First in the head and inline, so the class is on <html> before the
        first paint: a stored choice applied after it is a flash. Storage can
        be refused, and then the system preference decides. */
    }
    <script is:inline>
      try {
        const t = localStorage.getItem('niwa-theme')
        if (t === 'light' || t === 'dark') document.documentElement.classList.add('theme-' + t)
      } catch {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === undefined ? 'niwa' : `${title} · niwa`}</title>
    <meta name="description" content={description} />
    {
      /* Browser chrome follows the platform preference; the media attribute
        reads no other signal. The two values are the ground token. */
    }
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    {
      /* The dev server's StyleX stylesheet.
        StyleX collects its rules while it transforms the sources, and serves
        them from this route. It reaches the page through a Vite hook that
        rewrites `index.html`, which is a file this site does not have: every
        route is an `.astro` component. So dev pages arrived unstyled, and the
        one line that was missing is this one. The build needs nothing: there
        the rules are appended to the stylesheet Astro emits.
        The route answers `no-store`, so a reload always shows the latest. */
    }
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
  </head>
  <body>
    <a href="#main" {...stylex.props(styles.skip)}>Skip to content</a>
    <Header pathname={pathname} />
    <div {...stylex.props(styles.page, toc !== undefined && styles.pageWithToc)}>
      <Sidebar pathname={pathname} variant="rail" />
      <main id="main" {...stylex.props(styles.main)} data-pagefind-body={indexed ? '' : undefined}>
        <slot />
      </main>
      {toc !== undefined && <Toc headings={toc} />}
    </div>
    <Footer />
    <Search />
  </body>
</html>
