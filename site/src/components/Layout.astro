---
/* The page.
 *
 * Bar across the top, rail down the side, article in the middle, contents
 * on the right above 1280. All of it is HTML, and all of it stays HTML: no
 * part of the chrome hydrates, and a documentation page mounts no React at
 * all. The three small scripts it does load only make controls work.
 *
 * The page is the one scroller for the article. The rail scrolls only
 * itself, and only when it is taller than the window.
 */
import type { Heading } from '../lib/headings'
import '../styles/app.css'
import Bar from './Bar.astro'
import { Footer } from './Footer'
import Rail from './Rail.astro'
import Search from './Search.astro'
import Toc from './Toc.astro'

interface Props {
  /** Absent on the landing, where the site's name is the whole title. */
  title?: string
  description: string
  /** Absent when the page has no headings. The contents then do not exist. */
  headings?: readonly Heading[]
  /** Search indexes every page unless the page says otherwise. Opting out
   * is for pages that answer nobody's search, like the 404. */
  indexed?: boolean
  /**
   * The page draws its own full-width bands, so it takes no rail and no
   * reading cap. Its way into the documentation is the bar's drawer, which
   * on such a page opens at every width.
   */
  wide?: boolean
  /**
   * The page the rail should mark, when that is not the page's own URL. A
   * source view is a second face of a documentation page, not a place of
   * its own, so the rail keeps pointing at the page it is the source of.
   */
  navPath?: string
}

const { title, description, headings, indexed = true, wide = false, navPath } = Astro.props
const pathname = navPath ?? Astro.url.pathname
const outline = headings !== undefined && headings.length > 0 ? headings : undefined
---

<!doctype html>
<html lang="en">
  <head>
    {
      /* First in the head and inline, so the class is on <html> before the
        first paint: a stored choice applied after it is a flash. Storage can
        be refused, and then the system preference decides.
        `data-theme` carries the same choice for the design system's tokens;
        the bar's control keeps the two in step from then on. */
    }
    <script is:inline>
      try {
        const t = localStorage.getItem('niwa-theme')
        if (t === 'light' || t === 'dark') {
          document.documentElement.classList.add('theme-' + t)
          document.documentElement.setAttribute('data-theme', t)
        }
      } catch {}
    </script>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === undefined ? 'niwa' : `${title} · niwa`}</title>
    <meta name="description" content={description} />
    {
      /* Browser chrome follows the platform preference; the media attribute
        reads no other signal. The two values are the ground token. */
    }
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    {
      /* The dev server's StyleX stylesheet. StyleX serves its collected
        rules from this route, and reaches a page through a Vite hook that
        rewrites `index.html` — a file this site does not have. The build
        needs nothing: there the rules are appended to Astro's stylesheet. */
    }
    {import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Bar pathname={pathname} wide={wide} />

    <div class:list={['shell', wide && 'shell-wide']}>
      {
        !wide && (
          <>
            <Rail pathname={pathname} />
            {
              /* Beside the element rather than in a module, because a
                module is deferred and a restore the reader watches happen
                is not a restore. This runs while the parser is still in the
                body, before the first paint. With nothing stored the rail
                opens at the page the reader is on. */
            }
            <script is:inline>
              (function () {
                var rail = document.currentScript.previousElementSibling
                if (!rail) return
                var at = null
                try {
                  at = sessionStorage.getItem('niwa-rail-scroll')
                } catch (e) {}
                if (at !== null) {
                  rail.scrollTop = Number(at)
                  return
                }
                var here = rail.querySelector('[aria-current="page"]')
                if (here && here.offsetTop > rail.clientHeight * 0.6) {
                  rail.scrollTop = here.offsetTop - rail.clientHeight / 2
                }
              })()
            </script>
          </>
        )
      }

      <div class:list={['page', wide && 'page-wide']}>
        {
          /* `id="main"`, not `id="article"`: the documentation template
            renders an `<article id="article">` inside this element, and two
            elements cannot share an id. The skip link aims here, which is
            the outer of the two and right for every page. */
        }
        <main class="page-article" id="main" data-pagefind-body={indexed ? '' : undefined}>
          <slot />
        </main>
        {
          outline !== undefined && (
            <aside class="toc">
              <Toc headings={outline} />
            </aside>
          )
        }
      </div>
    </div>

    {
      /* The drawer is the only part of the chrome that needs a script, so
        it is the only part a reader without one loses. They are given the
        same rail once more, below the article. With a script this element
        is text and not markup, so there is never a second navigation
        landmark on the page. */
    }
    <noscript>
      <div class:list={['noscript-rail', !wide && 'noscript-rail-narrow']}>
        <Rail pathname={pathname} inDrawer />
      </div>
    </noscript>

    <Footer />
    <Search />
    {
      /* Both are named unconditionally. Astro hoists and bundles a `<script>`
        it can see at compile time, and one written inside a conditional
        expression is not that: it is dropped from the build silently. Each
        script looks for its own element and returns when the page has none,
        which is the same outcome for a few hundred bytes. */
    }
    <script src="../scripts/chrome.ts"></script>
    <script src="../scripts/toc.ts"></script>
  </body>
</html>
