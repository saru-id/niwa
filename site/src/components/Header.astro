---
import * as stylex from '@stylexjs/stylex'
import { SITE } from '../nav'
import { styles } from './Header.styles'
import { styles as shell } from './Layout.styles'
import Sidebar from './Sidebar.astro'
import ThemeControl from './ThemeControl.astro'

interface Props {
  pathname: string
  /**
   * The page renders no rail, so the header carries the navigation at every
   * width instead of handing it over above 1024. Only a page without a rail
   * may set it: two navigation landmarks on one page is one too many.
   */
  carriesNavigation?: boolean
}

const { pathname, carriesNavigation = false } = Astro.props
---

<header {...stylex.props(styles.header)}>
  <div {...stylex.props(shell.column, styles.bar)}>
    <a href="/" {...stylex.props(styles.wordmark)}>niwa</a>
    <div {...stylex.props(styles.controls)}>
      <button
        type="button"
        data-search-open
        aria-haspopup="dialog"
        aria-keyshortcuts="Meta+K Control+K"
        {...stylex.props(styles.search)}
      >
        {
          /* The hint is for the eye. `aria-keyshortcuts` is the same fact,
            said the way a screen reader says it. */
        }
        Search <kbd aria-hidden="true" {...stylex.props(styles.kbd)}>⌘K</kbd>
      </button>
      <ThemeControl />
      <a href={SITE.repository} {...stylex.props(styles.link)}>Repository</a>
    </div>
  </div>
  {
    /* Search needs its script and its index. Without them the button opens
      nothing, so it is not shown; the sidebar names every page anyway. */
  }
  <noscript>
    <style is:inline>
      [data-search-open] {
        display: none;
      }
    </style>
  </noscript>
  <details
    {...stylex.props(styles.disclosure, carriesNavigation && styles.disclosureAtEveryWidth)}
  >
    <summary {...stylex.props(shell.column, styles.disclosureLabel)}>Navigation</summary>
    <Sidebar pathname={pathname} variant="disclosure" atEveryWidth={carriesNavigation} />
  </details>
</header>
