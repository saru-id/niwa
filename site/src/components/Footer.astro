---
import * as stylex from '@stylexjs/stylex'
import { SITE } from '../nav'
import { styles } from './Footer.styles'
import { styles as shell } from './Layout.styles'

// Four items. The design document does not ship, so it is not among them.
const LINKS = [
  { href: SITE.repository, label: 'Repository' },
  { href: SITE.index, label: 'llms.txt' },
  { href: SITE.license, label: 'License' },
]
---

<footer {...stylex.props(styles.footer)}>
  <p {...stylex.props(shell.column, styles.line)}>
    niwa {SITE.version}{
      LINKS.map((link) => (
        <Fragment>
          {' · '}
          <a href={link.href} {...stylex.props(styles.link)}>
            {link.label}
          </a>
        </Fragment>
      ))
    }
  </p>
</footer>
